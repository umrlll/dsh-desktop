<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标使用 WinForms 的 NotifyIcon（WPF 没有内置托盘组件） -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DSHDesktop</RootNamespace>
    <AssemblyName>DSHDesktop</AssemblyName>
    <ApplicationIcon>DSH.ico</ApplicationIcon>
    <!-- 版本与产品元数据集中在仓库根的 Directory.Build.targets（版本号治理单一来源） -->
  </PropertyGroup>

  <!-- UseWindowsForms 会给 ImplicitUsings 注入 System.Windows.Forms / System.Drawing，
       会和 WPF 的 MessageBox 等类型冲突，这里去掉，改为按需全限定引用。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DSH.ico" />
    <None Update="DSH.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="dist\**" />
    <Compile Remove="icon\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="dist\**" />
    <EmbeddedResource Remove="icon\**" />
    <EmbeddedResource Remove="publish\**" />
    <None Remove="dist\**" />
    <None Remove="icon\**" />
    <None Remove="publish\**" />
    <Page Remove="dist\**" />
    <Page Remove="icon\**" />
    <Page Remove="publish\**" />
    <Compile Remove="runtime\**" />
    <EmbeddedResource Remove="runtime\**" />
    <None Remove="runtime\**" />
    <Content Remove="runtime\**" />
    <Page Remove="runtime\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSHDesktop.Core\DSHDesktop.Core.csproj" />
  </ItemGroup>

  <!-- ================= 内置运行时（Node + dsh）自动打包 ================= -->
  <PropertyGroup>
    <!-- 每次发布都从显式锁定输入重建暂存目录；不复用源码树下被忽略的本机 runtime。 -->
    <BundleRuntimeDir Condition="'$(BundleRuntimeDir)' == ''">$(MSBuildProjectDirectory)\obj\bundle-runtime\$(Configuration)</BundleRuntimeDir>
    <BundlePlatform Condition="'$(BundlePlatform)' == ''">win32</BundlePlatform>
    <BundleArchitecture Condition="'$(BundleArchitecture)' == ''">x64</BundleArchitecture>
    <BundleProfileSchema Condition="'$(BundleProfileSchema)' == ''">1</BundleProfileSchema>
    <BundleRuntimeId Condition="'$(BundleRuntimeId)' == '' And '$(BundleDshVersion)' != '' And '$(BundleNodeVersion)' != '' And '$(BundlePnpmVersion)' != ''">dsh-$(BundleDshVersion)-$(BundlePlatform)-$(BundleArchitecture)-node-$(BundleNodeVersion)-pnpm-$(BundlePnpmVersion)</BundleRuntimeId>
    <RuntimeManifestToolProject>$(MSBuildProjectDirectory)\..\DSHDesktop.RuntimeTool\DSHDesktop.RuntimeTool.csproj</RuntimeManifestToolProject>
    <RuntimeManifestToolDll>$(MSBuildProjectDirectory)\..\DSHDesktop.RuntimeTool\bin\$(Configuration)\net10.0\DSHDesktop.RuntimeTool.dll</RuntimeManifestToolDll>
    <BaseOutputPath>$(SolutionDir).build\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>

  <Target Name="ValidateBundleInputs" BeforeTargets="Publish" Condition="'$(SkipBundleRuntime)' != 'true'">
    <Error Condition="'$(BundleNodeSource)' == ''" Text="[Bundle] 缺少显式 BundleNodeSource；正式 publish 不读取本机默认 Node 路径。" />
    <Error Condition="'$(BundleDshSource)' == ''" Text="[Bundle] 缺少显式 BundleDshSource（应指向锁定的 node_modules）。" />
    <Error Condition="'$(BundlePnpmSource)' == ''" Text="[Bundle] 缺少显式 BundlePnpmSource（应指向含 node_modules\pnpm 的锁定前缀）。" />
    <Error Condition="'$(BundleNodeVersion)' == ''" Text="[Bundle] 缺少精确 BundleNodeVersion。" />
    <Error Condition="'$(BundleDshVersion)' == ''" Text="[Bundle] 缺少精确 BundleDshVersion。" />
    <Error Condition="'$(BundlePnpmVersion)' == ''" Text="[Bundle] 缺少精确 BundlePnpmVersion。" />
    <Error Condition="'$(BundleRuntimeId)' == ''" Text="[Bundle] 无法生成 BundleRuntimeId。" />
    <Error Condition="'$(BundleNodeSource)' != '' And !Exists('$(BundleNodeSource)')" Text="[Bundle] Node 来源不存在：$(BundleNodeSource)" />
    <Error Condition="'$(BundleDshSource)' != '' And !Exists('$(BundleDshSource)\@deepseek-ai\dsh\package.json')" Text="[Bundle] DSH 来源缺少 @deepseek-ai\dsh\package.json：$(BundleDshSource)" />
    <Error Condition="'$(BundlePnpmSource)' != '' And !Exists('$(BundlePnpmSource)\node_modules\pnpm\package.json')" Text="[Bundle] pnpm 来源缺少 node_modules\pnpm\package.json：$(BundlePnpmSource)" />
  </Target>

  <!-- 1) 从零暂存锁定的 Node、DSH 与 pnpm；复制失败由 MSBuild 直接终止。 -->
  <Target Name="PrepareBundleRuntime" DependsOnTargets="ValidateBundleInputs" Condition="'$(SkipBundleRuntime)' != 'true'">
    <RemoveDir Directories="$(BundleRuntimeDir)" Condition="Exists('$(BundleRuntimeDir)')" />
    <MakeDir Directories="$(BundleRuntimeDir)\node;$(BundleRuntimeDir)\dsh" />
    <MakeDir Directories="$(BundleRuntimeDir)\pnpm" />
    <ItemGroup>
      <_BundleDshFiles Include="$(BundleDshSource)\**\*" />
      <_BundlePnpmFiles Include="$(BundlePnpmSource)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(BundleNodeSource)" DestinationFolder="$(BundleRuntimeDir)\node" />
    <Copy SourceFiles="@(_BundleDshFiles)" DestinationFiles="@(_BundleDshFiles->'$(BundleRuntimeDir)\dsh\node_modules\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(_BundlePnpmFiles)" DestinationFiles="@(_BundlePnpmFiles->'$(BundleRuntimeDir)\pnpm\%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(BundleRuntimeDir)\dsh\package.json" Lines="{ &quot;private&quot;: true, &quot;dependencies&quot;: { &quot;@deepseek-ai/dsh&quot;: &quot;$(BundleDshVersion)&quot; } }" Overwrite="true" />
    <Error Condition="!Exists('$(BundleRuntimeDir)\node\node.exe')" Text="[Bundle] Node 暂存失败。" />
    <Error Condition="!Exists('$(BundleRuntimeDir)\dsh\node_modules\@deepseek-ai\dsh\lib\bin.js')" Text="[Bundle] DSH 暂存失败。" />
    <Error Condition="!Exists('$(BundleRuntimeDir)\pnpm\node_modules\pnpm\package.json')" Text="[Bundle] pnpm 暂存失败。" />
  </Target>

  <Target Name="BuildRuntimeManifestTool" Condition="'$(SkipBundleRuntime)' != 'true'">
    <MSBuild Projects="$(RuntimeManifestToolProject)" Targets="Build"
             Properties="Configuration=$(Configuration);VersionPrefix=$(VersionPrefix);VersionSuffix=$(VersionSuffix);BuildId=$(BuildId)" />
  </Target>

  <Target Name="GenerateRuntimeManifest"
          DependsOnTargets="PrepareBundleRuntime;PreparePluginSeed;RemovePluginSeedWhenDisabled;BuildRuntimeManifestTool"
          Condition="'$(SkipBundleRuntime)' != 'true'">
    <Exec Command="dotnet &quot;$(RuntimeManifestToolDll)&quot; generate --root &quot;$(BundleRuntimeDir)&quot; --output &quot;$(BundleRuntimeDir)\desktop-runtime.json&quot; --runtime-id &quot;$(BundleRuntimeId)&quot; --desktop-version &quot;$(_DshSemVer)&quot; --dsh-version &quot;$(BundleDshVersion)&quot; --node-version &quot;$(BundleNodeVersion)&quot; --pnpm-version &quot;$(BundlePnpmVersion)&quot; --platform &quot;$(BundlePlatform)&quot; --architecture &quot;$(BundleArchitecture)&quot; --profile-schema &quot;$(BundleProfileSchema)&quot;" />
  </Target>

  <!-- 2) 发布后：只复制本次从锁定输入生成且通过 manifest 自校验的 runtime。 -->
  <Target Name="CopyBundleRuntime" AfterTargets="Publish" DependsOnTargets="GenerateRuntimeManifest" Condition="'$(SkipBundleRuntime)' != 'true'">
    <RemoveDir Directories="$(PublishDir)runtime" Condition="Exists('$(PublishDir)runtime')" />
    <MakeDir Directories="$(PublishDir)runtime\versions\$(BundleRuntimeId)" />
    <ItemGroup>
      <_PreparedRuntimeFiles Include="$(BundleRuntimeDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PreparedRuntimeFiles)" DestinationFiles="@(_PreparedRuntimeFiles->'$(PublishDir)runtime\versions\$(BundleRuntimeId)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Exec Command="dotnet &quot;$(RuntimeManifestToolDll)&quot; activate --runtime-root &quot;$(PublishDir)runtime&quot; --runtime-id &quot;$(BundleRuntimeId)&quot;" />
    <Error Text="[Bundle] 发布 runtime 缺少活动槽 manifest。" Condition="!Exists('$(PublishDir)runtime\versions\$(BundleRuntimeId)\desktop-runtime.json')" />
    <Error Text="[Bundle] 发布 runtime 缺少 active.json。" Condition="!Exists('$(PublishDir)runtime\active.json')" />
    <Message Importance="high" Text="[Bundle] 内置运行时槽已打包并激活：$(BundleRuntimeId)" />
  </Target>

  <!-- ================= 可选：把打包机上已装的 profile 插件内置集成 =================
       发布时加 -p:BundleProfilePlugins=true，就会把某个 profile 的插件（清单 + 扁平
       node_modules）放进 runtime\profile-seed\；目标机器首次启动且该 profile 不存在时
       由 ProfileSeed 铺开，于是那些插件是"内置"的，不用再装。

       可调：
         -p:BundleProfilePluginsSource="%USERPROFILE%\.dsh\profiles\web"  换个来源 profile
         -p:BundleProfilePluginsExclude="dsh-context;zod"                 不带某些顶层包 -->
  <PropertyGroup>
    <BundleProfilePlugins Condition="'$(BundleProfilePlugins)' == ''">false</BundleProfilePlugins>
    <BundleProfilePluginsExclude Condition="'$(BundleProfilePluginsExclude)' == ''"></BundleProfilePluginsExclude>
  </PropertyGroup>

  <Target Name="PreparePluginSeed" DependsOnTargets="PrepareBundleRuntime"
          BeforeTargets="CopyBundleRuntime"
          Condition="'$(SkipBundleRuntime)' != 'true' And '$(BundleProfilePlugins)' == 'true'">
    <PropertyGroup>
      <_SeedDir>$(BundleRuntimeDir)\profile-seed</_SeedDir>
      <_SeedSourceReady Condition="Exists('$(BundleProfilePluginsSource)\package.json')">true</_SeedSourceReady>
    </PropertyGroup>

    <Error Text="[Bundle] BundleProfilePlugins=true 时必须显式传入含 package.json 的 BundleProfilePluginsSource。"
           Condition="'$(_SeedSourceReady)' != 'true'" />

    <ItemGroup Condition="'$(_SeedSourceReady)' == 'true'">
      <_SeedExcludeDirs Include="$(BundleProfilePluginsExclude)" Condition="'$(BundleProfilePluginsExclude)' != ''" />
    </ItemGroup>

    <!-- 每次从零暂存：robocopy 的 /XD 会保护被排除的目录不被 /PURGE 删除，靠增量复制
         无法让改小后的 BundleProfilePluginsExclude 生效。14MB 重铺一次可以忽略。 -->
    <RemoveDir Directories="$(_SeedDir)" Condition="Exists('$(_SeedDir)')" />
    <MakeDir Directories="$(_SeedDir)" Condition="'$(_SeedSourceReady)' == 'true'" />

    <!-- 清单与用户覆盖层；不复制 cordis.yml（每次启动都会重写，固化它没有意义） -->
    <Exec Condition="'$(_SeedSourceReady)' == 'true'"
          Command="robocopy &quot;$(BundleProfilePluginsSource)&quot; &quot;$(_SeedDir)&quot; package.json pnpm-lock.yaml pnpm-workspace.yaml cordis.patch.yml /NFL /NDL /NJH /NJS /NP"
          IgnoreExitCode="true" />

    <!-- 扁平 node_modules。排除 pnpm 内部目录与本机 store 元数据：.modules.yaml 等记录的是
         打包机的 store 绝对路径，带到别的机器会让 pnpm 判定 store 不一致而拒绝安装。 -->
    <Exec Condition="'$(_SeedSourceReady)' == 'true' And Exists('$(BundleProfilePluginsSource)\node_modules')"
          Command="robocopy &quot;$(BundleProfilePluginsSource)\node_modules&quot; &quot;$(_SeedDir)\node_modules&quot; /E /XD .pnpm .bin @(_SeedExcludeDirs) /XF .modules.yaml .package-map.json .pnpm-workspace-state-v1.json /NFL /NDL /NJH /NJS /NP"
          IgnoreExitCode="true" />

    <Message Importance="high" Text="[Bundle] 已内置集成插件：$(BundleProfilePluginsSource) → $(_SeedDir)"
             Condition="'$(_SeedSourceReady)' == 'true'" />
    <Warning Text="[Bundle] 内置集成的插件目录为空，请检查 BundleProfilePluginsSource。"
             Condition="'$(_SeedSourceReady)' == 'true' And !Exists('$(_SeedDir)\node_modules')" />
  </Target>

  <!-- CopyBundleRuntime 是整个 runtime\ 目录一起发，所以关掉开关时还必须清掉上一次留下的
       profile-seed，否则「不在发布时内置集成」这个选择会被残留目录架空。 -->
  <Target Name="RemovePluginSeedWhenDisabled" BeforeTargets="CopyBundleRuntime"
          Condition="'$(SkipBundleRuntime)' != 'true' And '$(BundleProfilePlugins)' != 'true'">
    <PropertyGroup>
      <_StaleSeed Condition="Exists('$(BundleRuntimeDir)\profile-seed')">true</_StaleSeed>
    </PropertyGroup>
    <RemoveDir Directories="$(BundleRuntimeDir)\profile-seed" Condition="'$(_StaleSeed)' == 'true'" />
    <Message Importance="high" Text="[Bundle] 未启用插件内置集成，已清除残留的 profile-seed。"
             Condition="'$(_StaleSeed)' == 'true'" />
  </Target>

</Project>
