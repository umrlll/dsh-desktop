{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Desktop locked Portable release inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "runtimeId", "desktopVersion", "dshVersion", "nodeVersion", "pnpmVersion", "platform", "architecture", "profileSchema", "node", "dsh", "pnpm"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "beta"] },
    "runtimeId": { "type": "string", "minLength": 1 },
    "desktopVersion": { "$ref": "#/$defs/exactVersion" },
    "dshVersion": { "$ref": "#/$defs/exactVersion" },
    "nodeVersion": { "$ref": "#/$defs/exactVersion" },
    "pnpmVersion": { "$ref": "#/$defs/exactVersion" },
    "platform": { "const": "win32" },
    "architecture": { "const": "x64" },
    "profileSchema": { "type": "integer", "minimum": 1 },
    "node": { "$ref": "#/$defs/artifact" },
    "dsh": { "$ref": "#/$defs/artifact" },
    "pnpm": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "exactVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
