{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dshdesktop.local/schemas/desktop-runtime.schema.json",
  "title": "DSH Desktop immutable runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "runtimeId", "desktopVersion", "dshVersion", "nodeVersion",
    "pnpmVersion", "platform", "architecture", "profileSchema", "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runtimeId": { "type": "string", "minLength": 1 },
    "desktopVersion": { "$ref": "#/$defs/exactVersion" },
    "dshVersion": { "$ref": "#/$defs/exactVersion" },
    "nodeVersion": { "$ref": "#/$defs/exactVersion" },
    "pnpmVersion": { "$ref": "#/$defs/exactVersion" },
    "platform": { "enum": ["win32", "darwin", "linux"] },
    "architecture": { "enum": ["x64", "arm64"] },
    "profileSchema": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "exactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
